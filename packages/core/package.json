{
  "name": "@agent-shell/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Business-agnostic agent runtime kernel",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugins/api.d.ts",
      "import": "./dist/plugins/api.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@langchain/langgraph-supervisor": "1.1.3",
    "@langchain/langgraph-swarm": "1.0.4",
    "@langchain/mcp-adapters": "2.0.1",
    "@langchain/openai": "1.8.0",
    "better-sqlite3": "12.10.0",
    "jiti": "2.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
