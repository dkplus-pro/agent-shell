{
  "name": "agent-shell-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, business-agnostic agent runtime shell",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,mts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,json,md}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "acceptance": "pnpm build && tsx tooling/acceptance/src/index.ts",
    "build": "pnpm -r --if-present build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm acceptance"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
